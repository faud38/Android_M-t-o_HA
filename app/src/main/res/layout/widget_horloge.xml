<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fond_widget" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="48"
        android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
        <TextClock android:id="@+id/heure" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#FFE1E1E1"
            android:textSize="46sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
        <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM" android:format24Hour="EEEE d MMMM" android:textColor="#FF9B9B9B"
            android:textSize="13sp" android:layout_marginTop="2dp" android:maxLines="1" />
        <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF9B9B9B" android:textSize="11sp" android:layout_marginTop="8dp"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/image" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="52"
        android:contentDescription="@string/app_name" android:scaleType="fitXY" />
</LinearLayout>
